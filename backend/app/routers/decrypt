from fastapi import APIRouter, HTTPException
from app.services import decrypt_service
from app.schemas.payload import DecryptPayloadRequest

router = APIRouter(tags=["decrypt"])


@router.post("/decrypt")

def post_payload_to_decrypt(request: DecryptPayloadRequest):
    try: 
        decrypted_res = decrypt_service.decrypt_payload(request.payload, request.decryption_key)
        return { "success": True, "decrypted_res": decrypted_res}

    except ValueError as err:
        raise HTTPException(status_code=400, detail=str(err))

